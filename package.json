{
  "name": "@arquiveapp/spatial",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source browser AR library. Early-stage research and development.",
  "license": "MIT",
  "author": "ARchive",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arquiveapp/spatial.git"
  },
  "homepage": "https://github.com/arquiveapp/spatial#readme",
  "bugs": {
    "url": "https://github.com/arquiveapp/spatial/issues"
  },
  "keywords": [
    "ar",
    "webar",
    "spatial",
    "browser"
  ],
  "packageManager": "npm@11.19.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.13.0",
      "onFail": "error"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/build.mjs --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:package": "publint --strict",
    "test": "npm run build && npm run test:unit && npm run test:package",
    "test:package": "node scripts/check-package.mjs",
    "check": "npm run format:check && npm run check:rights && npm run typecheck && npm run build && npm run test:unit && npm run lint:package && npm run test:package",
    "prepack": "npm run build",
    "test:unit": "node --test tests/*.test.mjs",
    "check:rights": "node tools/sbom/check.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "test:wasm": "node tests/wasm.mjs",
    "devlab": "node tools/devlab/serve.mjs",
    "sbom": "npm sbom --sbom-format cyclonedx"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "publint": "0.3.24",
    "typescript": "7.0.2"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@arquiveapp/spatial-core": "0.0.0"
  }
}
